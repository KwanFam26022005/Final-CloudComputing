# =============================================================================
# Đảm bảo chuẩn xuống dòng LF (Unix) khi mount file cấu hình vào Linux Container
# Tránh lỗi CRLF (\r\n) khi thành viên dùng Windows clone repo về chạy Docker
# =============================================================================
* text=auto eol=lf

*.sh text eol=lf
*.py text eol=lf
*.sql text eol=lf
*.conf text eol=lf
*.default text eol=lf
*.local text eol=lf
*.options text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.json text eol=lf
*.md text eol=lf
Dockerfile text eol=lf

*.ps1 text eol=crlf
