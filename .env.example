# =============================================================================
# MYMINICLOUD ENVIRONMENT CONFIGURATION (.env.example)
# Copy file này thành .env nếu muốn tùy chỉnh thông số:
#   cp .env.example .env
# =============================================================================

# --- Định danh nhóm / Sinh viên (Dùng cho Docker Hub & Realm/Dashboard) ---
DOCKERHUB_USERNAME=kwanfam
PROJECT_TAG=dev
MSSV_DEFAULT=sv001

# --- 1. Web Frontend Server ---
WEB_PORT=8080
WEB2_PORT=8082

# --- 2. Application Backend Server ---
APP_PORT=8085
APP_INTERNAL_PORT=8081
OIDC_ISSUER=http://authentication-identity-server:8080/realms/master
OIDC_AUDIENCE=myapp

# --- 3. Relational Database Server (MariaDB) ---
DB_PORT=3306
MARIADB_ROOT_PASSWORD=root
MARIADB_DATABASE=minicloud

# --- 4. Authentication & Identity Server (Keycloak) ---
AUTH_PORT=8081
KC_BOOTSTRAP_ADMIN_USERNAME=admin
KC_BOOTSTRAP_ADMIN_PASSWORD=admin
KC_HOSTNAME=localhost

# --- 5. Object Storage Server (MinIO) ---
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin

# --- 6. Internal DNS Server (Bind9) ---
DNS_PORT=1053

# --- 7. Monitoring (Prometheus & Node Exporter) ---
PROMETHEUS_PORT=9090
NODE_EXPORTER_PORT=9100

# --- 8. Visualization (Grafana) ---
GRAFANA_PORT=3000
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=admin

# --- 9. API Gateway / Reverse Proxy (Nginx) ---
PROXY_PORT=80
